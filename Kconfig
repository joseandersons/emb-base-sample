source "Kconfig.zephyr"

menu "App Network Settings"

config SNTP_HOSTNAME
	string "SNTP server hostname"
	default "pool.ntp.org"

config WIFI_SSID
	string "Wi-Fi SSID"
	default ""

config WIFI_PASSWD
	string "Wi-Fi password"
	default ""

config LOCAL_TIME
	int "Local time offset (hours)"
	range -12 14
	default 0

endmenu
